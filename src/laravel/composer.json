{
  "name": "d3vdigital/laravel-d3v-legal",
  "description": "Laravel adapter for D3V Legal Notices",
  "type": "laravel-package",
  "version": "2026.07.30",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/view": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "D3vDigital\\D3vLegal\\Laravel\\": "src/",
      "D3vDigital\\D3vLegal\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
