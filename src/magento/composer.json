{
    "name": "d3vdigital/magento-d3v-legal",
    "description": "Magento 2 adapter for D3V Legal Notices",
    "type": "magento2-module",
    "version": "2026.07.30",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0"
    },
    "autoload": {
        "files": [
            "app/code/D3vDigital/D3vLegal/registration.php"
        ],
        "psr-4": {
            "D3vDigital\\D3vLegal\\": "app/code/D3vDigital/D3vLegal/"
        }
    },
    "extra": {
        "map": [
            [
                "app/code/D3vDigital/D3vLegal",
                "app/code/D3vDigital/D3vLegal"
            ]
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
